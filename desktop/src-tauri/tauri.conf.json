{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taime",
  "version": "0.1.0",
  "identifier": "dev.taime.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "cargo build --manifest-path src-tauri/Cargo.toml -p taime-session-daemon && pnpm dev",
    "beforeBuildCommand": "bash scripts/stage-daemon.sh && pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Taime",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 600,
        "backgroundColor": "#0b0e13",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "decorations": true,
        "trafficLightPosition": { "x": 19, "y": 24 }
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["binaries"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
