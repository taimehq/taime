{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Taime",
  "version": "0.1.0",
  "identifier": "dev.taime.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Taime",
        "width": 1280,
        "height": 820,
        "minWidth": 920,
        "minHeight": 600,
        "backgroundColor": "#0b0e13"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
