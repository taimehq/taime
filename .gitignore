# --- Build artifacts / dependencies (never commit) ---
**/node_modules/
dist/
src-tauri/target/
src-tauri/gen/
**/.vite/

# Python
**/__pycache__/
*.py[cod]
**/.venv/
**/venv/
*.egg-info/

# Rust
**/target/

# Logs / OS
*.log
.DS_Store

# Local tooling state
.claude/scheduled_tasks.lock

# Playwright/test artifacts
.playwright-mcp/
loop-*.png
ws-*.png
taime-*.png

# Daemon staging dir: ignore the staged binary, keep the dir (.gitkeep) so the
# tauri-build resource check passes for bare `cargo build`.
src-tauri/binaries/*
!src-tauri/binaries/.gitkeep

# Local scratch (UI mockups, demo repos) — never commit
tmp/
